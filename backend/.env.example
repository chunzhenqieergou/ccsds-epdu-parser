DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=stms

# 串口 RS422 接收（默认 socket:// 虚拟串口演示，可改 COM3 等真实串口名）
RECEIVER_SERIAL_ENABLED=True
RECEIVER_SERIAL_PORT=socket://127.0.0.1:9123
RECEIVER_SERIAL_BAUD=115200

# 时序数据库：mongodb | mysql（mongodb 不可用时自动回退 mysql）
TSDB_BACKEND=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=stms
MONGODB_COLLECTION=telemetry_data
